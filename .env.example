# Copy this file to .env for local development.
# On Railway, set these as Variables in the project settings instead.

# OpenAI (powers the "Ask Tina" chatbot)
OPENAI_API_KEY=

# Google Sheets (lead capture spreadsheet)
# - Create a Google Cloud service account with the Sheets API enabled
# - Share the target spreadsheet with the service account email (Editor access)
# - GOOGLE_PRIVATE_KEY should be the full key from the JSON credentials,
#   including -----BEGIN PRIVATE KEY----- / -----END PRIVATE KEY----- lines
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Pushover (lead notifications)
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
